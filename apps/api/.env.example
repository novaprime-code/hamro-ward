APP_NAME="Hamro Ward"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=ne
APP_FALLBACK_LOCALE=en

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://admin.localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Central database (docs/12 §3) -------------------------------------------
# Local: hw_central. Shared server: hamroward.
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hw_central
DB_USERNAME=hw_owner
DB_PASSWORD=secret

# --- Tenant databases (docs/12 §2, §7, D-014) --------------------------------
# One database per local level, named hw_t_<8 hex>, copied from the template.
TENANT_DB_PREFIX=hw_t_
TENANT_DB_TEMPLATE=template_hamroward
# Application access to tenant data (production: hw_app)
TENANT_DB_USERNAME=hw_owner
TENANT_DB_PASSWORD=secret
# Migrations and grants inside tenant databases (hw_owner)
TENANT_OWNER_DB_USERNAME=hw_owner
TENANT_OWNER_DB_PASSWORD=secret
# Creates and drops tenant databases — CLI only; never in the web container in production
TENANT_PROVISIONER_USERNAME=hw_provisioner
TENANT_PROVISIONER_PASSWORD=secret
# Roles granted on each new tenant database; empty means skip
TENANT_DB_OWNER_ROLE=hw_owner
TENANT_DB_APP_ROLE=hw_app
TENANT_DB_BACKUP_ROLE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@hamroward.local"
MAIL_FROM_NAME="${APP_NAME}"

REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-in-every-environment

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SENTRY_LARAVEL_DSN=

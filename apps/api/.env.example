APP_NAME="Hamro Ward"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=ne
APP_FALLBACK_LOCALE=en

# Public site origin (used for links and, later, CORS/Sanctum)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://admin.localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Central database (docs/12 §3) -------------------------------------------
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hw_central
DB_USERNAME=hw_owner
DB_PASSWORD=secret

# --- Tenant databases (docs/12 §2) -------------------------------------------
# One database per local level, named <prefix><tenant_key>. The database name is
# set at runtime by the tenancy layer (HW-E29-F01-T02); these are its defaults.
TENANT_DB_PREFIX=hw_t_
TENANT_DB_USERNAME=hw_owner
TENANT_DB_PASSWORD=secret
TENANT_PROVISIONER_USERNAME=hw_provisioner
TENANT_PROVISIONER_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@hamroward.local"
MAIL_FROM_NAME="${APP_NAME}"

# Next.js on-demand revalidation (HW-E08-F01-T04)
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-in-every-environment

# Cloudflare Turnstile (v0.2)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SENTRY_LARAVEL_DSN=

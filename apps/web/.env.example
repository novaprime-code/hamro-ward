# Server-side calls from Next.js to Laravel (internal in production)
API_INTERNAL_URL=http://127.0.0.1:8000

# Origin of this site, read per request for canonical and share URLs (D-015)
HW_SITE_URL=http://localhost:3000

# Host that serves the staff dashboard, read per request (HW-E13-F02-T01, D-015)
HW_ADMIN_HOST=admin.localhost:3000

# Shared with Laravel; verifies signed revalidation calls (HW-E08-F01-T04)
REVALIDATE_SECRET=change-me-in-every-environment

# Server-side calls from Next.js to Laravel (internal in production)
API_INTERNAL_URL=http://127.0.0.1:8000

# Browser-visible origin of this site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host that serves the staff dashboard (HW-E13-F02-T01)
NEXT_PUBLIC_ADMIN_HOST=admin.localhost:3000

# Shared with Laravel; verifies signed revalidation calls (HW-E08-F01-T04)
REVALIDATE_SECRET=change-me-in-every-environment

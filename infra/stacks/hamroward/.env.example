# Copy to .env and edit: cp .env.example .env  (or paste into Portainer's
# environment variables in Advanced mode).
# Read by Docker Compose AND passed into every container of this stack.
# Don't use "$" in any value — Compose would try to expand it.

# --- Images built by GitHub Actions ------------------------------------------
# Pin a sha- tag to roll back (docs 04, "Rolling back an app").
HAMROWARD_API_IMAGE=ghcr.io/novaprime-code/hamro-ward-api:latest
HAMROWARD_WEB_IMAGE=ghcr.io/novaprime-code/hamro-ward-web:latest

# --- Application -------------------------------------------------------------
APP_NAME="Hamro Ward"
APP_ENV=production
# Generate with:
#   docker compose run --rm --no-deps -e AUTORUN_ENABLED=false app php artisan key:generate --show
# Store a copy in your password manager. Changing it later breaks encrypted data and sessions.
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=ne
APP_FALLBACK_LOCALE=en

# Same-origin setup: the site and the API share a hostname, and Next.js forwards
# /api to this stack's app container (docs/12 §11.2).
APP_URL=https://hw.jayshyampatel.com.np
FRONTEND_URL=https://hw.jayshyampatel.com.np
ADMIN_URL=https://admin.hw.jayshyampatel.com.np

# Logs go to "docker logs hamroward-app"
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Central database (shared PostgreSQL) ------------------------------------
DB_CONNECTION=central
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hamroward
# Request path: the application role
DB_USERNAME=hw_app
DB_PASSWORD=CHANGE_ME_HW_APP
# Migrations at container start: the schema owner
DB_OWNER_USERNAME=hw_owner
DB_OWNER_PASSWORD=CHANGE_ME_HW_OWNER

# --- Municipality databases --------------------------------------------------
# One database per local level, named hw_t_<8 hex>, copied from the template.
TENANT_DB_PREFIX=hw_t_
TENANT_DB_TEMPLATE=template_hamroward
TENANT_DB_USERNAME=hw_app
TENANT_DB_PASSWORD=CHANGE_ME_HW_APP
TENANT_OWNER_DB_USERNAME=hw_owner
TENANT_OWNER_DB_PASSWORD=CHANGE_ME_HW_OWNER
TENANT_DB_OWNER_ROLE=hw_owner
TENANT_DB_APP_ROLE=hw_app
TENANT_DB_BACKUP_ROLE=
# TENANT_PROVISIONER_PASSWORD is deliberately absent: creating a municipality is
# a one-off command that passes it in (PHASE-4.md).

# --- Redis (this stack's own container) --------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=hamroward-redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# Host-only cookies per hostname (docs/12 §11.2)
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=hw.jayshyampatel.com.np,admin.hw.jayshyampatel.com.np

# --- Uploads -----------------------------------------------------------------
# Local volume for now; switching to S3 or R2 later is an environment change.
FILESYSTEM_DISK=local

# --- Next.js runtime ---------------------------------------------------------
# Server-side fetches from Next.js to the API over the "web" network.
# NEXT_PUBLIC_* and the /api rewrite target are baked in at build time from the
# GitHub repository variables — changing those needs a rebuild, not a restart.
API_INTERNAL_URL=http://hamroward-app:8080
NEXT_PUBLIC_SITE_URL=https://hw.jayshyampatel.com.np

# Shared with Laravel; signs on-demand page refreshes. Generate: openssl rand -hex 32
REVALIDATE_URL=http://hamroward-web:3000/api/revalidate
REVALIDATE_SECRET=CHANGE_ME

# --- Mail (staff notifications, v0.2) ----------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@hw.jayshyampatel.com.np"
MAIL_FROM_NAME="Hamro Ward"

# --- Abuse protection (v0.2) -------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

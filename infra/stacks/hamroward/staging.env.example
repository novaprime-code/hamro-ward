# Staging stack — Portainer → Stacks → hamroward-staging → Environment
#
# The current Oracle A1 box. Keeps the existing domains.

HW_STACK=hamroward-staging

HAMROWARD_API_IMAGE=ghcr.io/<owner>/<repo>/api:staging
HAMROWARD_WEB_IMAGE=ghcr.io/<owner>/<repo>/web:staging

# Staging migrates itself on boot: that is where a broken migration should
# surface (D-015).
HW_MIGRATE_ON_BOOT=true

# APP_ENV=staging is what lets hw:demo:seed run here and refuse on production.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://hw.jayshyampatel.com.np

HW_SITE_URL=https://hw.jayshyampatel.com.np
HW_ADMIN_HOST=admin.hw.jayshyampatel.com.np

DB_DATABASE=hamroward_staging
SESSION_DOMAIN=hw.jayshyampatel.com.np
SANCTUM_STATEFUL_DOMAINS=hw.jayshyampatel.com.np,admin.hw.jayshyampatel.com.np

HW_THEME=himal

# Production stack — Portainer → Stacks → hamroward-prod → Environment
#
# Domain is not decided yet; everything below that mentions one is a
# placeholder. Nothing else changes when it is.

HW_STACK=hamroward-prod

HAMROWARD_API_IMAGE=ghcr.io/<owner>/<repo>/api:production
HAMROWARD_WEB_IMAGE=ghcr.io/<owner>/<repo>/web:production

# Deliberately false. Migrations are a decision here, not a side effect of a
# container restarting (D-015).
HW_MIGRATE_ON_BOOT=false

# APP_ENV=production is also what makes DemoGuard refuse to seed invented
# representatives here (docs/13 §4).
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<production-domain>

HW_SITE_URL=https://<production-domain>
HW_ADMIN_HOST=admin.<production-domain>

DB_DATABASE=hamroward
SESSION_DOMAIN=<production-domain>
SANCTUM_STATEFUL_DOMAINS=<production-domain>,admin.<production-domain>

HW_THEME=himal

# ─────────────────────────────────────────────────────────────────────────────
# STAGING — Portainer → Stacks → hamroward-staging → Environment
#
# The current Oracle A1 box, keeping the current domains.
# Copy each line into Portainer's environment editor; do not commit the filled
# version. Anything marked CHANGE ME has no safe default.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Images -----------------------------------------------------------------
# The moving tag: whatever the staging branch last built. Swap either for a
# sha-<commit> tag to pin or roll back — that is all a rollback is.
HAMROWARD_API_IMAGE=ghcr.io/OWNER/REPO/api:staging
HAMROWARD_WEB_IMAGE=ghcr.io/OWNER/REPO/web:staging

# ---- Application ------------------------------------------------------------
# APP_ENV=staging is load-bearing: it is what lets hw:demo:seed run here and
# refuse on production (docs/13 §4).
APP_ENV=staging
APP_DEBUG=false
APP_KEY=                                   # CHANGE ME — php artisan key:generate --show
APP_URL=https://hw.jayshyampatel.com.np

# Read at request time by the Next.js server; no rebuild when it changes.
HW_SITE_URL=https://hw.jayshyampatel.com.np
HW_ADMIN_HOST=admin.hw.jayshyampatel.com.np
HW_THEME=himal

# ---- Database ---------------------------------------------------------------
# Separate central database from production, on the same PostgreSQL server.
# Tenant databases (hw_t_*) are created per municipality by hw:tenant:create.
DB_CONNECTION=central
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hamroward_staging
DB_USERNAME=hw_app
DB_PASSWORD=                               # CHANGE ME
DB_OWNER_USERNAME=hw_owner
DB_OWNER_PASSWORD=                         # CHANGE ME

# ---- Sessions and cookies ---------------------------------------------------
# Host-only cookies keep citizen and staff sessions apart (docs/12 §11).
SESSION_DRIVER=redis
SESSION_DOMAIN=hw.jayshyampatel.com.np
SANCTUM_STATEFUL_DOMAINS=hw.jayshyampatel.com.np,admin.hw.jayshyampatel.com.np

# ---- Redis, queue, cache ----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ---- Logging ----------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=debug

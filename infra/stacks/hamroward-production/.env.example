# ═══════════════════════════════════════════════════════════════════════════
# HAMRO WARD — PRODUCTION
#
# Portainer → Stacks → hamroward-production → Environment variables
#              → Advanced mode → paste this → Deploy
#
# Replace every CHANGE_ME and every <production-domain>.
# Do NOT use the "$" character in any value: Docker Compose expands it.
# ═══════════════════════════════════════════════════════════════════════════

# ---- Images ---------------------------------------------------------------
# Moving tag: whatever the `main` branch last built.
# To roll back, swap either line for a sha-<commit> tag from the build summary.
HAMROWARD_API_IMAGE=ghcr.io/novaprime-code/hamro-ward-api:production
HAMROWARD_WEB_IMAGE=ghcr.io/novaprime-code/hamro-ward-web:production

# ---- Application ----------------------------------------------------------
# APP_ENV=production is load-bearing: it is what makes DemoGuard REFUSE to
# seed invented representatives here (docs/13 §4). Do not set
# HW_ALLOW_DEMO_DATA on this stack.
APP_NAME=Hamro Ward
APP_ENV=production
APP_KEY=CHANGE_ME_BASE64_KEY
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=ne
APP_FALLBACK_LOCALE=en
APP_URL=https://<production-domain>
FRONTEND_URL=https://<production-domain>
ADMIN_URL=https://admin.<production-domain>
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- Central database -----------------------------------------------------
# Separate central database from staging, same PostgreSQL server.
DB_CONNECTION=central
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hamroward
DB_USERNAME=hw_app
DB_PASSWORD=CHANGE_ME_HW_APP_PASSWORD
DB_OWNER_USERNAME=hw_owner
DB_OWNER_PASSWORD=CHANGE_ME_HW_OWNER_PASSWORD

# ---- Tenant databases -----------------------------------------------------
# A DIFFERENT PREFIX FROM STAGING, on purpose. Both stacks share one
# PostgreSQL server, and tenant database names are random (hw_t_5f3a9c1e).
# Without separate prefixes you cannot tell from `\l` which environment a
# database belongs to — and a staging cleanup could drop a production one.
TENANT_DB_PREFIX=hw_t_
TENANT_DB_TEMPLATE=template_hamroward
TENANT_DB_USERNAME=hw_app
TENANT_DB_PASSWORD=CHANGE_ME_HW_APP_PASSWORD
TENANT_OWNER_DB_USERNAME=hw_owner
TENANT_OWNER_DB_PASSWORD=CHANGE_ME_HW_OWNER_PASSWORD
TENANT_DB_OWNER_ROLE=hw_owner
TENANT_DB_APP_ROLE=hw_app
# Set once a dedicated backup role exists; empty skips its grants.
TENANT_DB_BACKUP_ROLE=

# ---- Redis, cache, queue, sessions ----------------------------------------
# Service names, not container names: `redis` is scoped to this stack's own
# network, so the same value is correct in both stacks (D-016).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=<production-domain>,admin.<production-domain>

# ---- Storage --------------------------------------------------------------
# Switches to s3 when object storage arrives (HW-E12-F01).
FILESYSTEM_DISK=local

# ---- Web app --------------------------------------------------------------
# API_INTERNAL_URL is read at runtime by the Next.js server for its data
# fetches, and `app` is the Compose service name.
API_INTERNAL_URL=http://app:8080
REVALIDATE_URL=http://web:3000/api/revalidate
REVALIDATE_SECRET=CHANGE_ME_RANDOM_HEX

# HW_SITE_URL replaces NEXT_PUBLIC_SITE_URL (D-015). A NEXT_PUBLIC_ value is
# compiled into the browser bundle, which would tie the image to one
# environment; these are read by the server at request time instead, so
# changing a domain needs a restart, not a rebuild.
HW_SITE_URL=https://<production-domain>
HW_ADMIN_HOST=admin.<production-domain>
HW_THEME=himal

# ---- Mail -----------------------------------------------------------------
# log writes mail to the container log and delivers nothing. That is fine
# until something emails a citizen — password resets in HW-E30 — at which
# point set MAIL_MAILER=smtp and fill the rest from a real provider.
# There is deliberately no Mailpit on production.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@<production-domain>

# ---- Anti-abuse -----------------------------------------------------------
# Empty disables the check. Fill before citizen issue reporting opens here.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

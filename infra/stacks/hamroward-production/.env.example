# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION — Portainer → Stacks → hamroward-production → Environment
#
# Domain is not decided yet: every <production-domain> below is a placeholder.
# Copy each line into Portainer's environment editor; do not commit the filled
# version. Anything marked CHANGE ME has no safe default.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Images -----------------------------------------------------------------
# The moving tag: whatever the main branch last built. Swap either for a
# sha-<commit> tag to pin or roll back — that is all a rollback is.
HAMROWARD_API_IMAGE=ghcr.io/OWNER/REPO/api:production
HAMROWARD_WEB_IMAGE=ghcr.io/OWNER/REPO/web:production

# ---- Application ------------------------------------------------------------
# APP_ENV=production is load-bearing: it is what makes DemoGuard REFUSE to seed
# invented representatives here (docs/13 §4).
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                   # CHANGE ME — php artisan key:generate --show
APP_URL=https://<production-domain>

# Read at request time by the Next.js server; no rebuild when it changes.
HW_SITE_URL=https://<production-domain>
HW_ADMIN_HOST=admin.<production-domain>
HW_THEME=himal

# ---- Database ---------------------------------------------------------------
# Separate central database from staging, on the same PostgreSQL server.
# Tenant databases (hw_t_*) are created per municipality by hw:tenant:create.
DB_CONNECTION=central
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hamroward
DB_USERNAME=hw_app
DB_PASSWORD=                               # CHANGE ME
DB_OWNER_USERNAME=hw_owner
DB_OWNER_PASSWORD=                         # CHANGE ME

# ---- Sessions and cookies ---------------------------------------------------
# Host-only cookies keep citizen and staff sessions apart (docs/12 §11).
SESSION_DRIVER=redis
SESSION_DOMAIN=<production-domain>
SANCTUM_STATEFUL_DOMAINS=<production-domain>,admin.<production-domain>

# ---- Redis, queue, cache ----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ---- Logging ----------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning
